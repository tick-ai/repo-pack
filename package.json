    "node": ">=22"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": ["ai", "llm", "prompt", "repository", "context", "gitignore", "tokens", "cli"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tick-ai/repo-pack.git"
  }
}
